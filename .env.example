ARI_URL=http://127.0.0.1:8088

ARI_USERNAME=asterisk
ARI_PASSWORD=asterisk

ARI_APP_NAME=ari_test_app
# HTTP API server (src/routes)
PORT=3000

# Event source(s) subscribed at startup (comma-separated): channel: bridge: deviceState:Custom:x endpoint:PJSIP
ARI_EVENT_SOURCE=channel:

# Outbound trunk used for originating calls (src/services/channels.service.js)
TRUNK_NAME=
TRUNK_CLI=
TRUNK_TECH=SIP